    "associative": "[B,8,8]",
    "init": "zeros(B,88), zeros(B,88), zeros(B,8,8)",
    "memory_orientation": "value-by-key",
    "observed_roles": "kind=2 is read_only for associative memory; not a no-op for fast/slow",
