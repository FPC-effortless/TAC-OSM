      "primary": "cluster_purity",
      "success_threshold": 0.85,
      "secondary": "verified_records_per_centroid"
    },
    "axon": {
      "primary": "parameterized_reuse_accuracy",
      "success_threshold": 0.95
    },
    "seca": {
      "primary": "verified_novel_composites",
      "success_threshold": 1,
      "secondary": "post_seca_composite_success_minus_pre_seca"
    },
    "regm": {
      "primary": "retained_competence_after_raw_removal",
      "success_threshold": 0.95
    },
    "closed_loop": {
      "required": [
        "verified transition learning",
        "durable reconstruction",
        "verified operator consolidation",
        "novel verified composition",
        "post-composition reuse"
      ]
    }
  },
  "non_claims": [
    "does not establish sublinear routing",
