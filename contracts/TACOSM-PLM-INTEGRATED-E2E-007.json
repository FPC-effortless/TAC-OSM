{
  "experiment_id": "TACOSM-PLM-INTEGRATED-E2E-007",
  "version": 1,
  "status": "pre-registered",
  "title": "Fresh confirmatory integrated multimodal PLM with selected residual state write",
  "question": "Can the selected hidden_dim=64 integrated PLM with the residual-linear persistent-state write interface solve a fresh held-out cross-modal Boolean benchmark end to end without auxiliary payload or entity supervision?",
  "hypothesis": "The residual-linear state-write configuration selected on the registered development split will meet or exceed the 0.80 held-out q2 criterion on a fresh composition set.",
  "primary_endpoint": {
    "name": "heldout_q2_accuracy_all_modalities",
    "unit": "episode",
    "threshold": 0.8,
    "selection": "none"
  },
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "protocol": {
    "train_steps": 300,
    "batch_size": 96,
    "hidden_dim": 64,
    "state_write_mode": "residual_linear",
    "entity_count": 16,
    "latent_bits": 12,
    "observation_entities_per_episode": 3,
    "evaluation_episodes_per_seed": 400,
    "observation_noise": 0.03,
    "optimizer": "AdamW",
    "learning_rate": 0.002,
    "weight_decay": 0.0001,
    "query_count": 2,
    "operator_dispatch": "fixed_query_conditioned",
    "representation_auxiliary_supervision": false,
    "model_selection": "none"
  },
  "arms": [
    {
      "name": "normal",
