      "intervention": "zero persistent state immediately before q1",
      "acts_on": "persistent information"
    },
    {
      "name": "shuffle_image",
      "intervention": "permute image observations across observed entities",
      "acts_on": "cross-modal alignment"
    },
    {
      "name": "text_only",
      "intervention": "replace image and audio with constants",
      "acts_on": "modality"
    },
    {
      "name": "image_only",
