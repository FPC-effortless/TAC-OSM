# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / run artifacts
#
# Legacy scratch output remains ignored by default. THIS IS NOT the location
# for published model checkpoints: every new/continued trained study must
# version original model/checkpoint bytes and its replay bundle at
# research/replay-bundles/<study_id>/ (or another declared git-tracked research
# path), following research/REPOSITORY-REPLAY-AND-CHECKPOINT-RULE.md.
# Do not treat regenerating weights from seeds, local ignored files, or
# expiring Actions artifacts as an adequate experiment archive.
#
# results/, runs/ and outputs/ are ignored scratch areas only.
.pytest_cache/
results/
runs/
outputs/

# Editors
.vscode/
.idea/
*.swp
.DS_Store
COMMIT_MSG.txt
