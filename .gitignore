# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / run artifacts
#
# Regenerable measurement output. The committed part of a result is the
# measurement script, the gates, the config and the claims ledger — not the
# weights and JSON the run happened to leave behind. Trained states are
# reproduced from deterministic seeds (claim C4), and results/*.json is
# regenerated by re-running scripts/*.py.
#
# The whole directory is ignored, not just its top-level JSON: "results/*.json"
# did not match results/trained_weights/*.json, so artifacts in subdirectories
# were silently un-ignored.
.pytest_cache/
results/
runs/
outputs/

# Editors
.vscode/
.idea/
*.swp
.DS_Store
